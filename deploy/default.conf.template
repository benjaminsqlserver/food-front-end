# nginx config for Cloud Run. ${PORT} is filled in at container start by the
# stock nginx entrypoint; every other $variable here is nginx's own.

server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Cloud Run sits behind a proxy that terminates TLS.
    absolute_redirect off;
    server_tokens     off;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   512;
    gzip_proxied      any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    # Never let a browser cache the shell of the page; a redeploy must be
    # visible immediately.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location = / {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Assets are not fingerprinted, so an hour is the sensible ceiling: long
    # enough to help a repeat visitor, short enough that a fix lands quickly.
    location /assets/ {
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # nginx's mime.types does not always map .webmanifest. `default_type` only
    # applies when no mapping was found, so this is safe either way — unlike a
    # `types { }` block, which would replace the inherited map wholesale and
    # break every other content type on the site.
    location ~* \.webmanifest$ {
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # The page loads nothing from anywhere else, so it can afford a strict
    # policy. 'unsafe-inline' covers the inline styles and the small classic
    # script in <head> that detects a failed module boot.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors *; base-uri 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
}
